{
  "name": "glambymriga/aurora",
  "description": "Aurora Beauty Salon Management Platform",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "psr/log": "^3.0",
    "ext-pdo": "*",
    "ext-json": "*",
    "ext-bcmath": "*",
    "ext-intl": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "phpstan/phpstan": "^1.10",
    "squizlabs/php_codesniffer": "^3.7"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/",
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:unit": "phpunit tests/Unit",
    "test:integration": "phpunit tests/Integration",
    "lint": "phpcs src --standard=PSR12",
    "stan": "phpstan analyse src --level=9",
    "migrate": "php bin/migrate.php",
    "seed": "php bin/seed.php"
  }
}
