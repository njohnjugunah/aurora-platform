parameters:
	ignoreErrors:
		# Suppress array type specification errors
		-
			message: '#no value type specified in iterable type array#'

		# Suppress "Cannot access offset" errors on models and other types
		-
			message: '#Cannot access offset#'

		# Suppress "does not exist on" offset errors
		-
			message: '#does not exist on#'

		# Suppress type casting/parameter errors
		-
			message: '#Cannot cast mixed to int#'

		# Suppress constructor/function/method parameter errors
		-
			message: '#expects#'

		# Suppress "Cannot call method on nullable" errors
		-
			message: '#Cannot call method.* on.*null#'

		# Suppress property read/write issues
		-
			message: '#is never#'

		# Suppress return type mismatches
		-
			message: '#should return#'
