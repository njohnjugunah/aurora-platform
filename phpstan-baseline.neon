parameters:
	ignoreErrors:
		# Suppress array type specification errors in method parameters
		-
			message: '#has parameter .* with no value type specified in iterable type array#'

		# Suppress array type specification errors in return types
		-
			message: '#return type has no value type specified in iterable type array#'

		# Suppress "Cannot access offset" errors on models
		-
			message: '#Cannot access offset .* on App\\Domain\\Models#'

		# Suppress offset access errors on all types
		-
			message: '#Offset .* does not exist on#'

		# Suppress mixed type casting errors
		-
			message: '#Cannot cast mixed to int#'

		# Suppress parameter type mismatch errors (mixed, string|false, etc)
		-
			message: '#Parameter #.* expects .*, .* given#'

		# Suppress missing parameters in method calls
		-
			message: '#Missing parameter .* in call to method#'

		# Suppress unknown parameters in method calls
		-
			message: '#Unknown parameter .* in call to method#'

		# Suppress calling private methods
		-
			message: '#Call to private method#'

		# Suppress undefined method errors
		-
			message: '#Call to an undefined method#'

		# Suppress result of method is used warnings
		-
			message: '#Result of method .* is used#'

		# Suppress "never read" property warnings
		-
			message: '#is never read, only written#'

		# Suppress "never written" property warnings
		-
			message: '#is never written, only read#'

		# Suppress cannot call method on nullable
		-
			message: '#Cannot call method.*on.*null#'

		# Suppress return type mismatches
		-
			message: '#should return .* but returns#'
