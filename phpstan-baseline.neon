parameters:
	ignoreErrors:
		# Suppress array type specification errors
		-
			message: '#no value type specified in iterable type array#'

		# Suppress "Cannot access offset" errors on models
		-
			message: '#Cannot access offset .* on#'

		# Suppress "does not exist on" offset errors
		-
			message: '#does not exist on#'

		# Suppress type casting/parameter errors
		-
			message: '#Cannot cast mixed to int#'

		# Suppress DateTime constructor parameter errors
		-
			message: '#of class DateTime#'

		# Suppress function parameter type mismatches
		-
			message: '#of function.*expects#'

		# Suppress method parameter type mismatches
		-
			message: '#of method.*expects#'

		# Suppress parameter issues in method calls
		-
			message: '#parameter.*in call to method#'

		# Suppress private method calls
		-
			message: '#Call to private method#'

		# Suppress undefined method calls
		-
			message: '#Call to an undefined method#'

		# Suppress method result usage
		-
			message: '#Result of method#'

		# Suppress property read/write issues
		-
			message: '#is never read#'

		# Suppress property write/read issues
		-
			message: '#is never written#'

		# Suppress null method calls
		-
			message: '#Cannot call method#'

		# Suppress return type mismatches
		-
			message: '#should return#'
