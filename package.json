    "@babel/preset-env": "^7.22.0",
    "babel-loader": "^9.1.0",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.0",
    "webpack-dev-server": "^4.15.0",
    "jest": "^29.5.0",
    "cypress": "^12.17.0",
    "eslint": "^8.42.0",
    "prettier": "^2.8.8"
  },
  "dependencies": {
    "bootstrap": "^5.3.0",
    "bootstrap-icons": "^1.11.0"
  }
