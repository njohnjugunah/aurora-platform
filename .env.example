APP_NAME=Aurora
APP_ENV=production
APP_DEBUG=false
APP_URL=https://aurora.glambymriga.com
APP_TIMEZONE=Africa/Nairobi

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=aurora_prod
DB_USERNAME=aurora_user
DB_PASSWORD=
DB_SSL=true

CACHE_DRIVER=redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

SESSION_DRIVER=redis
SESSION_LIFETIME=1440
SESSION_SECURE=true
SESSION_HTTPONLY=true
SESSION_SAMESITE=Lax

CSRF_TOKEN_LENGTH=32
RATE_LIMIT_ATTEMPTS=5
RATE_LIMIT_WINDOW=60

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@glambymriga.com
MAIL_FROM_NAME="Aurora - GlamByMariga"

MPESA_BUSINESS_SHORT_CODE=174379
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://aurora.glambymriga.com/api/v1/mpesa/callback

SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1234567890

JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600

SENTRY_DSN=
NEW_RELIC_LICENSE_KEY=

APP_KEY=
APP_CIPHER=AES-256-CBC
BCRYPT_ROUNDS=12

FEATURE_LOYALTY_POINTS=true
FEATURE_INVENTORY_TRACKING=true
FEATURE_STAFF_COMMISSION=true
FEATURE_CUSTOMER_PORTAL=true

LOG_LEVEL=error
LOG_CHANNEL=stack
